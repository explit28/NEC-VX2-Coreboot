+// SPDX-License-Identifier: BSD-2-Clause-Patent
+/** @file Panel descriptor keys and backlight calibration from LenovoVideoInitDxe. **/
+STATIC CONST UINT8 mPanelKeys[10][18] = {
+  { 0x00, 0x00, 0x00, 0xfe, 0x00, 0x42, 0x31, 0x35, 0x36, 0x58, 0x54, 0x4e, 0x30, 0x37, 0x2e, 0x31, 0x20, 0x0a },
