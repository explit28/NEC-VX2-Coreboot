diff --git a/src/device/cardbus_device.c b/src/device/cardbus_device.c
index 2eb070e7e1..876a001878 100644
--- a/src/device/cardbus_device.c
+++ b/src/device/cardbus_device.c
@@ -82,11 +82,15 @@ void cardbus_read_resources(struct device *dev)
 	cardbus_record_bridge_resource(dev, moving, CARDBUS_IO_SIZE,
 				       PCI_CB_IO_BASE_1, IORESOURCE_IO);
 
-	/* If I can, enable prefetch for mem0. */
+	/* Match the OEM CardBus window order on the NEC VersaPro VX-2. */
 	ctl = pci_read_config16(dev, PCI_CB_BRIDGE_CONTROL);
 	ctl &= ~PCI_CB_BRIDGE_CTL_PREFETCH_MEM0;
 	ctl &= ~PCI_CB_BRIDGE_CTL_PREFETCH_MEM1;
-	ctl |= PCI_CB_BRIDGE_CTL_PREFETCH_MEM0;
+	if (CONFIG(BOARD_NEC_VERSAPRO_VX2) &&
+	    dev->vendor == 0x1217 && dev->device == 0x8134)
+		ctl |= PCI_CB_BRIDGE_CTL_PREFETCH_MEM1;
+	else
+		ctl |= PCI_CB_BRIDGE_CTL_PREFETCH_MEM0;
 	pci_write_config16(dev, PCI_CB_BRIDGE_CONTROL, ctl);
 	ctl = pci_read_config16(dev, PCI_CB_BRIDGE_CONTROL);
 
@@ -108,8 +112,11 @@ void cardbus_read_resources(struct device *dev)
 	moving = moving_base & moving_limit;
 
 	/* Initialize the memory space constraints on the current bus. */
+	type = IORESOURCE_MEM;
+	if (ctl & PCI_CB_BRIDGE_CTL_PREFETCH_MEM1)
+		type |= IORESOURCE_PREFETCH;
 	cardbus_record_bridge_resource(dev, moving, CARDBUS_MEM_SIZE,
-				       PCI_CB_MEMORY_BASE_1, IORESOURCE_MEM);
+				       PCI_CB_MEMORY_BASE_1, type);
 
 	compact_resources(dev);
 }
@@ -131,9 +138,34 @@ void cardbus_enable_resources(struct device *dev)
 	pci_dev_enable_resources(dev);
 }
 
+static void cardbus_set_resources(struct device *dev)
+{
+	static const unsigned int window_bases[] = {
+		PCI_CB_MEMORY_BASE_0,
+		PCI_CB_MEMORY_BASE_1,
+		PCI_CB_IO_BASE_0,
+		PCI_CB_IO_BASE_1,
+	};
+
+	pci_dev_set_resources(dev);
+
+	if (!CONFIG(BOARD_NEC_VERSAPRO_VX2) ||
+	    dev->vendor != 0x1217 || dev->device != 0x8134)
+		return;
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(window_bases); i++) {
+		const struct resource *res = probe_resource(dev, window_bases[i]);
+
+		if (!res || !res->size || !(res->flags & IORESOURCE_STORED))
+			continue;
+
+		pci_write_config32(dev, window_bases[i] + 4, resource_end(res));
+	}
+}
+
 struct device_operations default_cardbus_ops_bus = {
 	.read_resources   = cardbus_read_resources,
-	.set_resources    = pci_dev_set_resources,
+	.set_resources    = cardbus_set_resources,
 	.enable_resources = cardbus_enable_resources,
 	.scan_bus         = pci_scan_bridge,
 	.reset_bus        = pci_bus_reset,
