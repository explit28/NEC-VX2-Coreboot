diff --git a/src/include/device/pci_def.h b/src/include/device/pci_def.h
index 577dac3377732217a30738f94866e7c8e228104c..ba32831c8b3d119bf280caf0b7b7de1988afb30d 100644
--- a/src/include/device/pci_def.h
+++ b/src/include/device/pci_def.h
@@ -158,6 +158,7 @@
 #define PCI_CB_MEMORY_LIMIT_0	0x20
 #define PCI_CB_MEMORY_BASE_1	0x24
 #define PCI_CB_MEMORY_LIMIT_1	0x28
+#define  PCI_CB_MEMORY_RANGE_MASK	~0x0fffU
 #define PCI_CB_IO_BASE_0	0x2c
 #define PCI_CB_IO_BASE_0_HI	0x2e
 #define PCI_CB_IO_LIMIT_0	0x30
@@ -166,7 +167,7 @@
 #define PCI_CB_IO_BASE_1_HI	0x36
 #define PCI_CB_IO_LIMIT_1	0x38
 #define PCI_CB_IO_LIMIT_1_HI	0x3a
-#define  PCI_CB_IO_RANGE_MASK	~0x03
+#define  PCI_CB_IO_RANGE_MASK	~0x03U
 /* 0x3c-0x3d are same as for htype 0 */
 #define PCI_CB_BRIDGE_CONTROL	0x3e
 /* Similar to standard bridge control register */
