diff --git a/src/mainboard/nec/versapro_vx2/bootblock.c b/src/mainboard/nec/versapro_vx2/bootblock.c
new file mode 100644
index 0000000000000000000000000000000000000000..1a2a496dd6628b908a5c7d001756ce9d104484cb
--- /dev/null
+++ b/src/mainboard/nec/versapro_vx2/bootblock.c
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+/*
+ * NEC VersaPro VX-2 / LA-C423P.
+ *
+ * Early native-function muxing for the NPCE388N LPC connection,
+ * based on pads observed under the NEC factory firmware.
+ *
+ * This does NOT attempt any vendor EC command sequence or change
+ * unknown power/reset GPIO outputs.
+ */
+#include <bootblock_common.h>
+#include <intelblocks/lpc_lib.h>
+#include <soc/gpio.h>
+
+static const struct pad_config early_gpio_table[] = {
+	/* EC LPC interface: RCIN#, LAD[0:3], LFRAME#, SERIRQ. */
+	PAD_CFG_NF(GPP_A0, NONE, DEEP, NF1),
+	PAD_CFG_NF(GPP_A1, NATIVE, DEEP, NF1),
+	PAD_CFG_NF(GPP_A2, NATIVE, DEEP, NF1),
+	PAD_CFG_NF(GPP_A3, NATIVE, DEEP, NF1),
+	PAD_CFG_NF(GPP_A4, NATIVE, DEEP, NF1),
+	PAD_CFG_NF(GPP_A5, NONE, DEEP, NF1),
+	PAD_CFG_NF(GPP_A6, NONE, DEEP, NF1),
+
+	/* CLKRUN# and two LPC clock outputs. */
+	PAD_CFG_NF(GPP_A8, NONE, DEEP, NF1),
+	PAD_CFG_NF(GPP_A9, NATIVE, DEEP, NF1),
+	PAD_CFG_NF(GPP_A10, NATIVE, DEEP, NF1),
+
+	/* DDR4 SPD SMBus: preserve the observed factory pad settings. */
+	_PAD_CFG_STRUCT(GPP_C0, PAD_FUNC(NF1) | PAD_RESET(DEEP) |
+		PAD_TRIG(OFF) | PAD_BUF(TX_DISABLE) | (1 << 1), 0),
+	_PAD_CFG_STRUCT(GPP_C1, PAD_FUNC(NF1) | PAD_RESET(DEEP) |
+		PAD_TRIG(OFF) | PAD_BUF(TX_DISABLE) | (1 << 1), 0),
+};
+
+void bootblock_mainboard_early_init(void)
+{
+	gpio_configure_pads(early_gpio_table, ARRAY_SIZE(early_gpio_table));
+	lpc_open_mmio_window(0xfe800000, 0x10000);
+}
diff --git a/src/mainboard/nec/versapro_vx2/cardbus.c b/src/mainboard/nec/versapro_vx2/cardbus.c
new file mode 100644
index 0000000000000000000000000000000000000000..775bd3e67c515a92f854ccfc203359933f556267
--- /dev/null
+++ b/src/mainboard/nec/versapro_vx2/cardbus.c
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <bootstate.h>
+#include <device/pci.h>
+
+/* Apply the board's tested OEM setup to the O2Micro CardBus controller. */
+static void configure_cardbus(void *unused)
+{
+	const struct device *root_port = pcidev_path_on_root(PCI_DEVFN(0x1c, 1));
+	if (!root_port || !root_port->enabled || root_port->vendor != 0x8086 ||
+	    root_port->device != 0x9d11 || !root_port->downstream)
+		return;
+
+	const struct device *cardbus = pcidev_path_behind(root_port->downstream, PCI_DEVFN(0, 0));
+	if (!cardbus || !cardbus->enabled || cardbus->vendor != 0x1217 ||
+	    cardbus->device != 0x8134)
+		return;
+
+	/* Controller-specific configuration from the NEC firmware sequence. */
+	pci_write_config8(cardbus, 0xd3, pci_read_config8(cardbus, 0xd3) & 0x7f);
+	pci_write_config32(cardbus, 0x40, 0x60cd17aa);
+	pci_write_config8(cardbus, 0xf6, (pci_read_config8(cardbus, 0xf6) & 0xf3) | 0x08);
+	pci_write_config8(cardbus, 0xdb, pci_read_config8(cardbus, 0xdb) | 0x40);
+	pci_write_config8(cardbus, 0xe8, pci_read_config8(cardbus, 0xe8) & 0xf3);
+	pci_write_config8(cardbus, 0x90, pci_read_config8(cardbus, 0x90) | 0x03);
+	pci_write_config8(cardbus, 0xf4, pci_read_config8(cardbus, 0xf4) | 0x02);
+	pci_write_config8(cardbus, 0x91, pci_read_config8(cardbus, 0x91) | 0x01);
+	pci_write_config8(cardbus, 0xdc, pci_read_config8(cardbus, 0xdc) & 0xbf);
+	pci_write_config8(cardbus, 0xf1, pci_read_config8(cardbus, 0xf1) | 0x70);
+	pci_write_config8(cardbus, 0xf5, (pci_read_config8(cardbus, 0xf5) & 0xc3) | 0x34);
+	pci_write_config8(cardbus, 0xd3, pci_read_config8(cardbus, 0xd3) | 0x80);
+}
+
+BOOT_STATE_INIT_ENTRY(BS_PAYLOAD_BOOT, BS_ON_ENTRY, configure_cardbus, NULL);
diff --git a/src/mainboard/nec/versapro_vx2/devicetree.cb b/src/mainboard/nec/versapro_vx2/devicetree.cb
new file mode 100644
