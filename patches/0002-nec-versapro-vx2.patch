new file mode 100644
index 0000000000000000000000000000000000000000..4aa88ba2a460b7d31f96b541356b648b28b42275
--- /dev/null
+++ b/src/mainboard/nec/versapro_vx2/dsdt.asl
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * NEC VersaPro VX-2 / LA-C423P
+ * Mainboard ACPI tables.
+ * Minimal EC is included automatically by Skylake lpc.asl.
+ * Battery, fan and hotkeys are not yet implemented.
+ */
+
+#include <acpi/acpi.h>
+
+DefinitionBlock(
+	"dsdt.aml",
+	"DSDT",
+	ACPI_DSDT_REV_2,
+	OEM_ID,
+	ACPI_TABLE_CREATOR,
+	COREBOOT_OEM_REVISION
+)
+{
+	#include <acpi/dsdt_top.asl>
+	#include <soc/intel/common/block/acpi/acpi/platform.asl>
+	#include <soc/intel/common/block/acpi/acpi/globalnvs.asl>
+	#include <cpu/intel/common/acpi/cpu.asl>
+
+	Device (\_SB.PCI0)
+	{
