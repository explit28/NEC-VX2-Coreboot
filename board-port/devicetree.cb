# SPDX-License-Identifier: GPL-2.0-only
# NEC VersaPro VX-2 / LA-C423P
# Experimental configuration

chip soc/intel/skylake
	# External USB 2.0 ports. Overcurrent mapping from NEC BIOS 1.21.
	# Use provisional PHY tuning until the OEM values are verified.
	register "usb2_ports" = "{
		[0] = USB2_PORT_MID(OC0), /* Rear */
		[1] = USB2_PORT_MID(OC0), /* Right upper */
		[2] = USB2_PORT_MID(OC1), /* Right middle */
		[3] = USB2_PORT_MID(OC1), /* Right lower */
		[4] = USB2_PORT_MID(OC2), /* Left */
		[7] = USB2_PORT_MID(OC_SKIP), /* AX200 Bluetooth */
	}"

	# USB3 overcurrent mapping from NEC BIOS 1.21.
	register "usb3_ports" = "{
		[0] = { .enable = 1, .ocpin = OC0 },
		[1] = { .enable = 1, .ocpin = OC0 },
		[2] = { .enable = 1, .ocpin = OC1 },
		[3] = { .enable = 1, .ocpin = OC1 },
		[4] = { .enable = 1, .ocpin = OC2 },
	}"

	device domain 0 on
		device ref igpu on
			register "gfx" = "GMA_STATIC_DISPLAYS(0)"
            register "panel_cfg" = "{
                .up_delay_ms = 200,
                .down_delay_ms = 50,
                .cycle_delay_ms = 600,
                .backlight_on_delay_ms = 1,
                .backlight_off_delay_ms = 200,
                .backlight_pwm_hz = 200,
            }"
        end
		device ref sa_thermal on end
		device ref thermal on end
		# CLKREQ routing from the OEM FIA dump. CLKOUT_SRC numbers assume
		# the Intel ICC default mapping and need hardware verification.
		device ref pcie_rp1 on end
		# CardBus
		device ref pcie_rp2 on
			register "PcieRpClkReqSupport[1]" = "true"
			register "PcieRpClkReqNumber[1]" = "4"
			register "PcieRpClkSrcNumber[1]" = "4"
		end
		# WLAN
		device ref pcie_rp4 on
			register "PcieRpClkReqSupport[3]" = "true"
			register "PcieRpClkReqNumber[3]" = "1"
			register "PcieRpClkSrcNumber[3]" = "1"
		end
		# NVMe
		device ref pcie_rp5 on
			register "PcieRpClkReqSupport[4]" = "true"
			register "PcieRpClkReqNumber[4]" = "5"
			register "PcieRpClkSrcNumber[4]" = "5"
		end
		# SD card reader
		device ref pcie_rp12 on
			register "PcieRpClkReqSupport[11]" = "true"
			register "PcieRpClkReqNumber[11]" = "2"
			register "PcieRpClkSrcNumber[11]" = "2"
		end
		device ref south_xhci on end
		device ref sata on
			# OEM AHCI implemented-port mask 0x7.
			register "SataPortsEnable[0]" = "1"
			register "SataPortsEnable[1]" = "1"
			register "SataPortsEnable[2]" = "1"
		end
		device ref lpc_espi on
			register "serirq_mode" = "SERIRQ_CONTINUOUS"
			register "lpc_ioe" = "LPC_IOE_EC_62_66 | LPC_IOE_KBC_60_64 | LPC_IOE_COMA_EN"
			chip drivers/pc80/tpm
				device pnp 0c31.0 on end
			end
		end
		device ref hda on end
		device ref smbus on end
		device ref gbe on end
	end
end
